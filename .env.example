# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_a_large_random_string
GOOGLE_CLIENT_ID=433261777203-2cmdeen156bpoi6se920f96vb3so1e7r.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional override for local databases or remote Postgres
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/forge?sslmode=disable

# Optional Supabase configuration for cloud storage and auth
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider keys
# Use mock for the built-in free fallback, or hugggingface with a valid HF token.
FORGE_AI_PROVIDER=mock
FORGE_AI_MODEL=demo
FORGE_AI_API_KEY=
FORGE_TRUSTED_DOMAINS=google.com,producthunt.com,crunchbase.com,linkedin.com,statista.com,microsoft.com,ycombinator.com,techcrunch.com,patents.google.com

# Optional rate limit overrides
GLOBAL_RATE_LIMIT=200
AUTH_RATE_LIMIT=10
FORGE_GENERATE_RATE_LIMIT=20
